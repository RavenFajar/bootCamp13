@{
}
@* @model DepartmentPortal.Models.AddDepartment *@
@model DepartmentPortal.DTOs.DepartmentCreateDto
<h2>Add Department</h2>

 @* Display validation summary *@
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                @Html.ValidationMessageFor(m => m.DepartmentName, "", new { @class = "text-danger" })

<form method="post">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" asp-for="DepartmentName"/>
        <span asp-validation-for="DepartmentName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <input class="form-control" asp-for="Location"/>
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Add Subject</button>
</form>